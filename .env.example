# Postgres connection string (Vercel dashboard -> Storage -> Create Database -> Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Discord Developer Portal (discord.com/developers/applications) -> your app -> OAuth2.
# Redirect URI to register there: <your-domain>/api/auth/callback/discord
# For local dev, also register: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Vercel dashboard -> Storage -> Create Database -> Blob. Only needed starting Phase 4.
BLOB_READ_WRITE_TOKEN=""
